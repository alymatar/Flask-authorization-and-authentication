# Copy this file to .env and fill in your own values.
# Never commit .env — it is listed in .gitignore.

# Flask secret key (use a long random string)
SECRET_KEY=change-me

# JWT signing key (use a different long random string)
JWT_SECRET_KEY=change-me-too

# Token lifetimes (optional; these are the defaults)
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/flask_auth

# Set to 1 to run the dev server in debug mode
FLASK_DEBUG=0
